    {
      "id": 5,
      "type": "timeseries",
      "title": "Operation Rate by Operation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
